{
    "manifest_version": 3,
    "name": "Browser Stability & Performance Optimizer",
    "version": "1.0",
    "description": "Stabilize Chrome, reclaim RAM, discard inactive tabs, and manage extensions from one compact optimizer popup.",
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "permissions": [
        "tabs",
        "management",
        "webRequest",
        "webRequestBlocking"
    ],
    "host_permissions": [
        "*://*.doubleclick.net/*",
        "*://*.google-analytics.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    }
}